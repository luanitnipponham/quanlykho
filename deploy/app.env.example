# Sao chép file này thành deploy/app.env rồi sửa lại giá trị thật.
#   cp deploy/app.env.example deploy/app.env
# KHÔNG commit deploy/app.env — file đã nằm trong .gitignore.

# --- PostgreSQL ------------------------------------------------------------
POSTGRES_USER=quanlykho
POSTGRES_PASSWORD=doi_mat_khau_nay
POSTGRES_DB=quanlykho

# Backend nối tới service "db" trong mạng nội bộ của compose.
# Ba giá trị dưới phải khớp POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB ở trên.
DATABASE_URL=postgresql://quanlykho:doi_mat_khau_nay@db:5432/quanlykho?schema=public

# --- Bảo mật ---------------------------------------------------------------
# BẮT BUỘC đổi trước khi chạy thật. Sinh chuỗi ngẫu nhiên:
#   openssl rand -base64 48
JWT_SECRET=doi_chuoi_nay_thanh_gia_tri_ngau_nhien_that_dai
JWT_EXPIRES_IN=15m

# Chỉ cần đổi khi đặt tên miền và bật HTTPS (xem docs/deploy.md muc 6).
# nginx phục vụ giao diện cùng gốc với API nên mặc định đã đủ.
CORS_ORIGIN=http://localhost

# --- Tuỳ chọn --------------------------------------------------------------
# Mật khẩu của 5 tài khoản mẫu khi nạp dữ liệu lần đầu.
SEED_PASSWORD=Password@123
# Đặt false nếu không muốn tự nạp dữ liệu mẫu vào CSDL trống.
SEED_ON_START=true
